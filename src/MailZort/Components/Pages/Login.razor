@page "/login"
@layout MainLayout
@attribute [AllowAnonymous]

<PageTitle>Sign in - MailZort</PageTitle>

<div class="login-card">
    <h1>MailZort</h1>
    <p class="muted">Sign in to manage sorting, senders and history.</p>

    @if (Locked != null)
    {
        <div class="alert error">Too many failed attempts. Try again in @Locked minute(s).</div>
    }
    else if (ShowError)
    {
        <div class="alert error">That username and password did not match.</div>
    }

    <form method="post" action="/auth/login">
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <label>
            Username
            <input name="username" autocomplete="username" autofocus />
        </label>
        <label>
            Password
            <input name="password" type="password" autocomplete="current-password" />
        </label>
        <button class="primary" type="submit">Sign in</button>
    </form>

    <p class="muted small">First run? The account is <code>admin</code> / <code>admin</code>, and you will be asked to change it.</p>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "locked")]
    public string? Locked { get; set; }

    private bool ShowError => !string.IsNullOrEmpty(Error);
}
